{
  "extends": "../../tsconfig-settings.json",
  "compilerOptions": {
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {},
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/rcTest.ts"
  ],
  "exclude": [
    "node_modules/**",
    "bak/**",
    "build/**",
    "coverage/**"
  ],
  "typedocOptions": {
    "entryPoints": [
      "src"
    ],
    "entryPointStrategy": "expand"
  }
}